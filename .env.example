# ─────────────────────────────────────────────────────────────────
#  COR AMANS — Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit the .env file — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────

# App
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-64-char-hex-string
APP_URL=http://localhost:5000

# Database (PostgreSQL)
# Local dev:  postgresql://postgres:yourpassword@localhost/cor_amans_db
# Docker:     overridden automatically by docker-compose.yml (host = "db")
# Cloud:      paste the DATABASE_URL from Railway / Render here
DATABASE_URL=postgresql://postgres:yourpassword@localhost/cor_amans_db

# ── Clerk Authentication ──────────────────────────────────────────
# Get keys at https://dashboard.clerk.com → API Keys
# Leave blank to use the built-in email/password auth instead
CLERK_PUBLISHABLE_KEY=paste-your-clerk-publishable-key-here
CLERK_SECRET_KEY=paste-your-clerk-secret-key-here
CLERK_WEBHOOK_SECRET=paste-your-clerk-webhook-secret-here

# ── Paystack (Payments) ───────────────────────────────────────────
# Get keys at https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=paste-your-paystack-secret-key-here
PAYSTACK_PUBLIC_KEY=paste-your-paystack-public-key-here

# ── Email (Flask-Mail) ────────────────────────────────────────────
# Gmail example — use an App Password, NOT your login password
# https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=COR AMANS <noreply@coramans.org>
