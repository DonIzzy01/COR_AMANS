# ─────────────────────────────────────────────────────────────────
#  COR AMANS — Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit the .env file — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-64-char-hex-string
APP_URL=http://localhost:5000

# ── Database (PostgreSQL via PgBouncer in Docker) ────────────────
# Docker:  overridden by docker-compose.yml — uses pgbouncer:5432
# Cloud:   paste the DATABASE_URL from Railway / Render / Supabase
DATABASE_URL=postgresql://postgres:yourpassword@localhost/cor_amans_db

# ── Redis (rate limiting, sessions, Celery) ───────────────────────
# Docker:  set automatically to redis://redis:6379/0 in compose
# Local:   install Redis and point to redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ── Object Storage (S3 / Cloudflare R2 / MinIO) ──────────────────
# Leave STORAGE_BACKEND=local to store uploads on disk (default).
# Set to "s3" to store PDFs and images in object storage.
STORAGE_BACKEND=local
S3_BUCKET=cor-amans
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=auto

# ── CDN ──────────────────────────────────────────────────────────
# Public base URL for stored files (leave blank to serve locally)
# Example: https://cdn.coramans.org  or  https://pub-xxxx.r2.dev
CDN_URL=

# ── Paystack (Payments) ───────────────────────────────────────────
PAYSTACK_SECRET_KEY=paste-your-paystack-secret-key-here
PAYSTACK_PUBLIC_KEY=paste-your-paystack-public-key-here

# ── Email (Flask-Mail) ────────────────────────────────────────────
# Use an App Password for Gmail, NOT your login password
# https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=COR AMANS <noreply@coramans.org>
